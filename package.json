{
  "name": "fleet-monitor",
  "version": "0.1.0",
  "description": "Uptime, SSL, broken-link, Lighthouse, noindex and cookie-banner monitor for a fleet of websites",
  "license": "MIT",
  "homepage": "https://fleet-monitor-lovat.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/zgfun/fleet-monitor"
  },
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:local": "tsx scripts/local-db.mts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx scripts/seed.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "vercel-build": "drizzle-kit migrate && tsx scripts/seed.ts --if-empty && next build"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.37.0",
    "@emotion/react": "^11.14.0",
    "cheerio": "^1.2.0",
    "drizzle-orm": "^0.45.3",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "p-limit": "^7.3.3",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.32.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.3",
    "dotenv": "^18.0.5",
    "drizzle-kit": "^0.31.11",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@10.15.0"
}
