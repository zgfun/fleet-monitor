# Local: docker compose up -d  (Postgres on port 5433)
# Production: a Neon connection string
DATABASE_URL=postgres://fleet:fleet@localhost:5433/fleet

# Single admin password for the dashboard. Use a long random value (openssl rand -base64 24):
# the login is public. Changing it signs out every session.
ADMIN_PASSWORD=change-me-please
# Random string used to sign the session cookie (openssl rand -hex 32)
SESSION_SECRET=
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET"
CRON_SECRET=

# Optional: alert emails via Resend. Alerts are skipped when unset.
RESEND_API_KEY=
ALERT_FROM=
ALERT_TO=
# Optional: public base URL, used for the "open in dashboard" link in alert emails.
APP_URL=

# Optional: Lighthouse scores via PageSpeed Insights. Skipped when unset.
PAGESPEED_API_KEY=

# Optional: separate database for DB-backed tests; they are skipped when unset or unreachable.
# Never point this at real data: tests insert and delete rows.
TEST_DATABASE_URL=
